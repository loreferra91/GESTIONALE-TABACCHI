{
  "id": "gestionale-supervisor",
  "name": "Gestionale Supervisor",
  "description": "Read-only access to the allowlisted Gestionale supervision API.",
  "version": "0.1.1",
  "categories": [
    "other"
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "baseUrl": {
        "type": "string",
        "minLength": 1
      },
      "token": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 32
          },
          {
            "type": "object",
            "required": [
              "source",
              "provider",
              "id"
            ],
            "properties": {
              "source": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "env"
                  },
                  {
                    "type": "string",
                    "const": "file"
                  },
                  {
                    "type": "string",
                    "const": "exec"
                  },
                  {
                    "type": "string",
                    "const": "store"
                  }
                ]
              },
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "id": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        ]
      },
      "timeoutMs": {
        "type": "integer",
        "minimum": 250,
        "maximum": 10000,
        "default": 4000
      }
    },
    "additionalProperties": false
  },
  "configContracts": {
    "secretInputs": {
      "bundledDefaultEnabled": false,
      "paths": [
        {
          "path": "token",
          "expected": "string",
          "ownerKind": "capability"
        }
      ]
    }
  },
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "gestionale_read"
    ]
  },
  "toolMetadata": {
    "gestionale_read": {
      "optional": true
    }
  }
}
